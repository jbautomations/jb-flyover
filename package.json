    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.170.0",
    "typescript": "5.6.3"
  }
